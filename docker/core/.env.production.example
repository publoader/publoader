# ============================================================================
# PRODUCTION core environment — copy to `.env.production` and fill in.
#
#   cp docker/core/.env.production.example docker/core/.env.production
#   ./scripts/publoader prod up -d
#
# Every variable here also accepts a `<VAR>_FILE` form pointing at a file, so
# Docker/Swarm secrets work without changing this file (config.ts resolves it).
#
# Rules that make production production:
#   - images are PINNED to an exact version, never `latest`, so a restart can
#     never silently change what is running;
#   - MangaDex points at the real API, so uploads are real;
#   - the dashboard is on the real hostname behind the tunnel.
# ============================================================================

# --- deployment identity ---------------------------------------------------
# Used as the compose project name by scripts/publoader: it namespaces the
# containers, network and DATA VOLUME, which is what lets staging and
# production coexist on one host without ever sharing a database.
PUBLOADER_ENV=prod

# --- images (PINNED — bump deliberately, never track `latest`) --------------
PUBLOADER_CORE_IMAGE=ardax/publoader-core:2.1.3
PUBLOADER_MIGRATE_IMAGE=ardax/publoader-core-migrate:2.1.3

# --- database --------------------------------------------------------------
POSTGRES_USER=publoader
POSTGRES_DB=publoader
# REQUIRED. Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
# Must match the three values above. Host is the compose service name.
DATABASE_URL=postgresql://publoader:CHANGE_ME@postgres:5432/publoader?schema=public&connection_limit=10

# --- admin API + dashboard -------------------------------------------------
# Break-glass root credential: wildcard scope, owner-equivalent. Keep it in a
# vault, NOT in any client. Day-to-day clients get scoped `pa_…` tokens minted
# from the dashboard or CLI. Generate: openssl rand -base64 36
ADMIN_TOKEN=
# Signs dashboard session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_MINUTES=720
# Set true when the proxy in front does NOT send x-forwarded-proto.
SESSION_COOKIE_SECURE=false
# Seeded owner account; sign in with ADMIN_TOKEN once, then set its password.
DASH_OWNER_EMAIL=iam@ardax.dev
DASH_PUBLIC_URL=https://publoader.ardax.dev


# --- MangaDex (REAL — these uploads are public) ----------------------------
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_AUTH_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=

# Scanlation group UUIDs whose members may sign in to the dashboard, comma- or
# space-separated. This is the "known people" gate for MangaDex login: leave it
# EMPTY and self-signup is refused outright, so the only way in is an OWNER
# inviting a MangaDex username from the Users view. Either way each operator
# needs their OWN personal API client — MangaDex has no authorization_code
# flow, and a personal client only works for the account that created it.
MANGADEX_ALLOWED_GROUP_IDS=
MANGADEX_RATELIMIT_MS=2000
UPLOAD_RETRY=3

# --- notifications ---------------------------------------------------------
# Comma/newline separated Discord webhook URLs. Blank disables notifications.
DISCORD_WEBHOOK_URLS=

# --- Discord bot (optional) ------------------------------------------------
DISCORD_BOT_TOKEN=
# A SCOPED token minted with the discord-bot preset — never ADMIN_TOKEN:
#   publoader-admin tokens create --name discord-bot --scopes discord-bot
BOT_API_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USERS=
DISCORD_ADMIN_ROLES=
DISCORD_ALLOWED_CHANNELS=

# --- ingress ---------------------------------------------------------------
# Cloudflare Zero Trust tunnel token. Route publoader.ardax.dev -> core-api:8100.
TUNNEL_TOKEN=

# --- tuning ----------------------------------------------------------------
LOG_LEVEL=info
LEASE_TTL_SECONDS=300
SWEEP_INTERVAL_SECONDS=30
SCHEDULER_INTERVAL_SECONDS=30
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
LEASE_POLL_WAIT_SECONDS=25

# --- ingress + optional services -------------------------------------------
# How the outside world reaches the dashboard/API:
#   tunnel  Cloudflare tunnel (cloudflared). No open ports, no public IP, no
#           certificates to manage. Requires TUNNEL_TOKEN.
#   direct  Caddy on 80/443 with a Let's Encrypt certificate it renews itself.
#           Requires a DNS A/AAAA record for PUBLOADER_HOSTNAME pointing at this
#           host, and inbound tcp/80 + tcp/443 open (80 is used for the ACME
#           challenge, so it is not optional). Set PUBLOADER_HOSTNAME + ACME_EMAIL.
#   none    Internal only: nothing is published. Reach it via an SSH tunnel.
PUBLOADER_INGRESS=tunnel
PUBLOADER_HOSTNAME=publoader.ardax.dev
ACME_EMAIL=
# Run the Discord bot alongside the core (needs DISCORD_BOT_TOKEN + BOT_API_TOKEN).
PUBLOADER_ENABLE_BOT=false

# --- GitHub push webhook (optional) ----------------------------------------
# A push to a tracked extensions repo publishes a bundle per changed extension,
# so the next scheduled run uses the new code. Full setup, limits and the
# trade-off against CI-side publishing: docs/webhooks.md.
#
# PREFER CI. Turning this on puts a GitHub token and a build toolchain inside
# core-api, which is the service exposed to the internet. A GitHub Actions
# workflow running `publoader-admin bundle publish` with a scoped
# `bundles:write` token needs neither. This exists for a deployment with no CI.
#
# Blank GITHUB_WEBHOOK_SECRET disables the endpoint: it answers 503 rather than
# accepting unsigned deliveries. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Owner that must match repository.full_name, so a fork cannot publish here.
GITHUB_REPO_OWNER=publoader
# Comma-separated repo names whose pushes publish bundles.
GITHUB_EXTENSIONS_REPOS=publoader-extensions,publoader-extensions-private
# Pushes here are acknowledged and do nothing: core deploys are image-based
# (`./scripts/publoader prod upgrade <tag>`). Set it only so the delivery log
# says so explicitly instead of "untracked repo".
GITHUB_CORE_REPO=publoader
# Fine-grained PAT, Contents:read on the extensions repos. Required for the
# private one. Prefer GITHUB_TOKEN_FILE with a Docker secret.
GITHUB_TOKEN=
