# Core control-plane configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# This file is the example and is committed. `.env` holds real credentials and
# must NEVER be committed — it is covered by .dockerignore so it also
# cannot end up inside an image layer. For anything beyond a single-operator
# host, prefer Docker secrets: every variable below is also accepted as
# <VAR>_FILE pointing at a file (see the note at the bottom of
# docker-compose.yml).

# --- required ---------------------------------------------------------------

# Postgres superuser password for the stack's database. Only ever travels over
# the internal compose network. Generate: openssl rand -base64 36
POSTGRES_PASSWORD=

# Bearer token for /api/v1/admin/* — the operator CLI, Discord bot and
# dashboard authenticate with it. Anyone holding it can trigger runs, publish
# bundles, mint worker enroll tokens and revoke workers, so treat it like a
# root password. Minimum 16 characters (config.ts rejects shorter); the API
# answers 503 on the whole admin surface if it is unset.
# Generate: openssl rand -base64 48
ADMIN_TOKEN=

# HMAC key for the dashboard's session cookies (/dash). Optional: if unset, a
# key is derived from ADMIN_TOKEN and core-api warns at boot — which means
# rotating ADMIN_TOKEN signs every operator out. Rotating this value is the
# only way to revoke dashboard sessions, and it revokes all of them at once.
# Minimum 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in minutes (default 720 = 12h). Shorten it if operators use
# shared or unmanaged browsers: a stolen cookie is valid until it expires.
SESSION_TTL_MINUTES=

# Force the Secure attribute on the session cookie. Normally inferred from
# x-forwarded-proto, which cloudflared sends; set to true if your proxy does not.
SESSION_COOKIE_SECURE=

# The OWNER account seeded at core-api startup. It starts with no credentials:
# sign in once with ADMIN_TOKEN and set a password from the dashboard's Users
# view, or link a Discord account with this email address.
DASH_OWNER_EMAIL=iam@ardax.dev

# Public origin the browser reaches.
DASH_PUBLIC_URL=https://publoader.ardax.dev

# MangaDex account used by core-uploader (the only writer) and core-processor
# (reads). Workers never receive these.
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=

# Scanlation group UUIDs whose members may sign in to the dashboard, comma- or
# space-separated. This is the "known people" gate for MangaDex login: leave it
# EMPTY and self-signup is refused outright, so the only way in is an OWNER
# inviting a MangaDex username from the Users view. Either way each operator
# needs their OWN personal API client — MangaDex has no authorization_code
# flow, and a personal client only works for the account that created it.
MANGADEX_ALLOWED_GROUP_IDS=

# Cloudflare tunnel token from Zero Trust > Networks > Tunnels. This token is
# the tunnel's identity — whoever has it can serve traffic on your hostname.
TUNNEL_TOKEN=

# --- optional: database -----------------------------------------------------

# POSTGRES_USER=publoader
# POSTGRES_DB=publoader
# Override only if you point the stack at an external database. The default is
# built from POSTGRES_PASSWORD and the in-stack `postgres` service.
# DATABASE_URL=postgresql://publoader:password@postgres:5432/publoader?schema=public&connection_limit=10

# --- optional: MangaDex -----------------------------------------------------

# MANGADEX_API_URL=https://api.mangadex.org
# MANGADEX_AUTH_URL=https://auth.mangadex.org/realms/mangadex/protocol/openid-connect
# Minimum gap between MangaDex requests. Lowering this risks account-level rate
# limiting; the upload endpoints are stricter than the read ones.
# MANGADEX_RATELIMIT_MS=2000
# UPLOAD_RETRY=3

# --- optional: notifications ------------------------------------------------

# Comma-separated Discord webhook URLs for upload/failure notifications.
# DISCORD_WEBHOOK_URLS=

# --- optional: queue tuning -------------------------------------------------

# How long a leased job is held before the sweeper reclaims it. Must exceed the
# worker's heartbeat/renew interval by a comfortable margin, or healthy workers
# will have jobs stolen out from under them mid-run.
# LEASE_TTL_SECONDS=300
# SWEEP_INTERVAL_SECONDS=30
# SCHEDULER_INTERVAL_SECONDS=30
# Exponential retry backoff bounds for failed jobs.
# RETRY_BASE_SECONDS=60
# RETRY_MAX_SECONDS=3600
# Long-poll window for the worker lease endpoint. Keep below any proxy or
# tunnel idle timeout on the path (Cloudflare's default is 100s).
# LEASE_POLL_WAIT_SECONDS=25

# --- optional: logging ------------------------------------------------------

# trace|debug|info|warn|error. `debug` logs every request; do not leave it on.
# LOG_LEVEL=info

# --- optional: images -------------------------------------------------------

# By default the stack builds the images locally from this repo. Point these at
# a registry to deploy pre-built, digest-pinned images instead (see
# docs/deployment.md "Upgrading").
# PUBLOADER_CORE_IMAGE=ardax/publoader-core:2.1.3
# PUBLOADER_MIGRATE_IMAGE=ardax/publoader-core-migrate:2.1.3

# --- required: Discord control bot ------------------------------------------
# Full setup, including the Developer Portal steps and the command reference:
# docs/bot.md. Remove the `publoader-bot` service from docker-compose.yml if you
# do not want a bot; these variables are only read by it.

# The BOT token from the Discord Developer Portal (your app → Bot → Reset
# Token). Not the client secret, not the public key, not the OAuth token used
# for dashboard login. Paste it unquoted.
DISCORD_BOT_TOKEN=

# A SCOPED per-client API token (`pa_…`) for the bot. Mint one with:
#   publoader-admin tokens create --name discord-bot \
#     --scopes runs:write,workers:read,extensions:read,untracked:write,stats:read,audit:read
# Do NOT put ADMIN_TOKEN here. ADMIN_TOKEN is `*` — every scope, forever,
# including bundle publishing and minting more tokens — and the bot is the
# component most exposed to other people's input. The scope list above is the
# `discord-bot` preset (`publoader-admin tokens scopes`); add extensions:write,
# settings:write, workers:write or enroll:write only if you want the commands
# they unlock (docs/bot.md lists which command needs which scope).
BOT_API_TOKEN=

# The one guild the bot serves. Strongly recommended: slash commands then
# register instantly instead of taking up to an hour to propagate globally, and
# the bot refuses commands from anywhere else. Right-click the server →
# Copy Server ID (Developer Mode must be on).
DISCORD_GUILD_ID=

# Who may run state-changing commands, as comma- or space-separated Discord
# user ids. With BOTH this and DISCORD_ADMIN_ROLES empty, every mutating
# command is refused — the bot fails closed. (The legacy Python bot did the
# opposite and allowed everyone when unconfigured.)
DISCORD_ADMIN_USERS=

# Role ids whose holders count as admins. Same format; either mechanism is
# enough on its own.
DISCORD_ADMIN_ROLES=

# Channel ids the bot accepts commands from. Reads are allowed anywhere when
# this is empty, but writes are refused until it is set — so set it to the
# channel that controls the platform.
DISCORD_ALLOWED_CHANNELS=

# --- optional: Discord control bot ------------------------------------------

# Where the bot reaches the admin API. The default goes through the Cloudflare
# tunnel, so the bot passes the same WAF and rate limits as every other client.
# Setting http://core-api:8100 is faster but bypasses both.
# CORE_URL=https://publoader.ardax.dev
